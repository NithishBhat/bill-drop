#!/bin/bash
# Boot script: install Docker, fetch the app bundle from S3, build and run the container.
# Logs: /var/log/cloud-init-output.log
set -euxo pipefail

dnf install -y docker unzip
systemctl enable --now docker

mkdir -p /opt/app
cd /opt/app
aws s3 cp "s3://${bucket}/${key}" app.zip --region "${region}"
unzip -o app.zip

docker build -t bill-drop .
docker rm -f bill-drop || true
docker run -d --name bill-drop --restart unless-stopped \
  -p 80:8501 -e AWS_REGION="${region}" bill-drop
